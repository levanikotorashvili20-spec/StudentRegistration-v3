// app.rc - program resources: icon and version information
// Compiled by rc.exe (Resource Compiler), not by the C++ compiler.

#include <windows.h>

// Icon ID 1 = IDI_APP in main.cpp
1 ICON "res\\app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    3,0,0,0
 PRODUCTVERSION 3,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Levan Kotorashvili"
            VALUE "FileDescription",  "Student Registration (C++)"
            VALUE "FileVersion",      "3.0.0.0"
            VALUE "InternalName",     "StudentRegistration"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Levan Kotorashvili"
            VALUE "OriginalFilename", "StudentRegistration v3.exe"
            VALUE "ProductName",      "Student Registration"
            VALUE "ProductVersion",   "3.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
